{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "android": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit1"
      }
    },
    "development-simulator": {
      "environment": "development",
      "developmentClient": true,
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit1"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit1"
      }
    },
    "unit2-development": {
      "environment": "development",
      "developmentClient": true,
      "android": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit2"
      }
    },
    "unit2-preview": {
      "distribution": "internal",
      "channel": "preview-unit2",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit2"
      }
    },
    "unit2-production": {
      "channel": "production-unit2",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "unit2"
      }
    },
    "pydah-development": {
      "environment": "development",
      "developmentClient": true,
      "android": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "pydah"
      }
    },
    "pydah-preview": {
      "distribution": "internal",
      "channel": "preview-pydah",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "pydah"
      }
    },
    "pydah-production": {
      "channel": "production-pydah",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "pydah"
      }
    }
  },
  "submit": {
    "production": {},
    "unit2-production": {},
    "pydah-production": {}
  }
}
